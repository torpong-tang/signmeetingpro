{
  "name": "signmeetingpro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -H 0.0.0.0 -p 3011",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "next start -H 127.0.0.1 -p 3011",
    "start:production": "HOSTNAME=127.0.0.1 PORT=3012 node .next/standalone/server.js",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:qa:e2e": "QA_ALLOW_DATA_WRITE=1 tsx scripts/qa-full-flow.ts && playwright test tests/e2e/qa-full-flow.spec.ts",
    "qa:full-flow": "tsx scripts/qa-full-flow.ts",
    "qa:registration-modes": "tsx scripts/qa-registration-modes.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "brace-expansion": "2.1.4",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@prisma/client": "^6.19.3",
    "@types/pdfkit": "^0.17.6",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "driver.js": "^1.8.0",
    "jose": "^6.2.4",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "pdfkit": "^0.19.1",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "sharp": "0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
